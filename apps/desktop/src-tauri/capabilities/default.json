{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "stronghold:default",
    "stronghold:allow-destroy",
    "stronghold:allow-remove-store-record",
    "updater:default",
    "process:allow-restart"
  ]
}
